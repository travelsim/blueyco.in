{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "blueycoin",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|_vercel(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    }
  ]
}
